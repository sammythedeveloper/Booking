<style>
  /* Premium Dark Theme Overrides for Navbar */
  .custom-luxury-nav {
    background-color: #0f1115 !important; /* Deep obsidian background */
    border-bottom: 1px solid #23272f !important; /* Subtle minimal edge divider */
  }

  .search-btn {
    background-color: #101115;
    color: #fff;
    border-radius: 25px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    border: none;
  }

  .search-btn:hover {
    background-color: #ffd700;
    color: #000000;
  }

  .search-btn i {
    display: inline;
    margin-right: 0.5rem;
  }

  .search-input {
    background-color: #1a1d24 !important; /* Darker inputs */
    border: 1px solid #2e3541 !important;
    color: #ffffff !important;
    border-radius: 25px;
    padding: 0.5rem 2rem;
    font-size: 1rem;
    width: 100%;
  }

  .search-input::placeholder {
    color: #8892b0 !important;
  }

  .search-input:focus {
    border-color: #ffd700 !important;
    box-shadow: 0 0 0 0.25rem rgba(254, 66, 77, 0.25) !important;
    outline: none;
  }

  .nav-item.nav-link {
    color: #c2c9d6 !important; /* Soft white/silver default text */
    transition: all 0.3s ease;
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 25px;
  }

  .nav-item.nav-link:hover {
    color: #fff !important;
    background-color: #ffd700;
  }

  /* Profile Icon Dropdown Styling */
  .profile-dropdown {
    position: relative;
    display: inline-block;
  }

  .profile-icon {
    font-size: 1.2rem;
    color: #ffffff !important;
    cursor: pointer;
    padding: 12px;
    border-radius: 50%;
    background-color: #1a1d24; /* Elevated circular container background */
    border: 1px solid #2e3541;
    transition: all 0.3s ease;
  }

  .profile-icon:hover {
    background-color: #ffd700;
    border-color: #fe424d;
    transform: scale(1.05);
  }

  .dropdown-menu {
    position: absolute;
    right: 0;
    top: 110%;
    background: #161920 !important; /* Deep background to match theme */
    border: 1px solid #2e3541 !important;
    box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.5) !important;
    border-radius: 12px !important;
    display: none;
    flex-direction: column;
    width: 160px;
    overflow: hidden;
    padding: 0.5rem 0;
  }

  .dropdown-menu a {
    text-decoration: none;
    padding: 10px 20px;
    color: #e2e8f0 !important; /* Soft off-white items */
    display: block;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .dropdown-menu a:hover {
    background: #ffd700 !important;
    color: black !important;
    padding-left: 24px; /* Subtle modern shift inward on hover */
  }

  .profile-dropdown:hover .dropdown-menu {
    display: flex;
  }

  /* Custom tweaks for the responsive hamburger menu icon */
  .navbar-toggler {
    border-color: #2e3541 !important;
  }

  .navbar-toggler-icon {
    color: white;
    filter: invert(
      1
    ); /* Forces standard hamburger menu icon to go bright white */
  }

  /* Hide Profile Icon on Mobile */
  @media (max-width: 768px) {
    .custom-luxury-nav .navbar-toggler-icon {
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255, 255, 255, 1%29' stroke-width='2' stroke-linecap='round' stroke-miterlimit='10' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e") !important;
      filter: none !important;
    }

    /* Soften the button container's border outline */
    .custom-luxury-nav .navbar-toggler {
      border-color: rgba(255, 255, 255, 0.2) !important;
      outline: none !important;
      box-shadow: none !important;
    }
    .profile-dropdown {
      display: none;
    }
  }
</style>

<!-- Updated structural bootstrap layout targeting navbar-dark parameters -->
<nav class="navbar navbar-expand-md navbar-dark custom-luxury-nav sticky-top">
  <a class="navbar-brand" href="/listings">
    <!-- Logo container -->
    <img src="/src/img/logo.png" alt="Logo" class="logo" />
  </a>
  <button
    class="navbar-toggler"
    type="button"
    data-bs-toggle="collapse"
    data-bs-target="#navbarNavAltMarkup"
    aria-controls="navbarNavAltMarkup"
    aria-expanded="false"
    aria-label="Toggle navigation"
  >
    <span class="navbar-toggler-icon"></span>
  </button>

  <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
    <div class="navbar-nav ms-auto">
      <!-- Search Bar Element -->
      <form
        class="d-flex navbar-nav-form"
        action="/listings/search"
        method="GET"
      >
        <input
          class="form-control me-2 search-input"
          type="text"
          name="query"
          placeholder="Search Destination"
          aria-label="Search"
        />
        <button class="btn search-btn my-2 my-sm-0" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>Search
        </button>
      </form>
    </div>

    <div class="navbar-nav ms-auto align-items-center">
      <div class="nav-link-container">
        <a class="nav-item nav-link" href="/listings/new">List Indulge</a>
      </div>

      <!-- Mobile View Dropdown (Visible in Mobile explicitly) -->
      <div class="d-md-none w-100 text-center mt-2">
        <% if (currUser) { %>
        <a class="nav-item nav-link d-block mb-1" href="/profile">Profile</a>
        <a class="nav-item nav-link d-block mb-1" href="/about">About</a>
        <a class="nav-item nav-link d-block mb-1" href="/contact">Contact</a>
        <a class="nav-item nav-link d-block mb-1" href="/logout">Logout</a>
        <% } else { %>
        <a class="nav-item nav-link d-block mb-1" href="/login">Login</a>
        <a class="nav-item nav-link d-block mb-1" href="/signup">Sign Up</a>
        <% } %>
      </div>

      <!-- Desktop View Profile Icon (Hidden in Mobile) -->
      <div class="profile-dropdown d-none d-md-inline ms-3">
        <i class="fa-solid fa-user profile-icon"></i>
        <div class="dropdown-menu">
          <% if (currUser) { %>
          <a href="/profile">Profile</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/logout">Logout</a>
          <% } else { %>
          <a href="/login">Login</a>
          <a href="/signup">Sign Up</a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</nav>
