<% layout("/layouts/boilerplate") %>

<div
  class="premium-hero"
  style="
    background-image: url('https://images.unsplash.com/photo-1618064541372-289bdb6f5b7b?q=80&w=2233&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');
  "
>
  <div class="premium-hero-content">
    <h1 class="display-2 gold-heading mb-3" data-aos="fade-up">
      Welcome to stayIndulgent
    </h1>
    <p
      class="lead text-light mb-4"
      style="letter-spacing: 1px"
      data-aos="fade-up"
      data-aos-delay="200"
    >
      Redefining luxury accommodation for discerning travelers
    </p>
    <a
      href="#our-story"
      class="btn btn-gold btn-lg"
      data-aos="fade-up"
      data-aos-delay="400"
    >
      Discover Our Story
    </a>
  </div>
</div>

<div class="container py-5 my-4" id="our-story">
  <div class="row align-items-center g-5">
    <div class="col-lg-6" data-aos="fade-right">
      <h2 class="section-title">Our Story</h2>
      <p class="text-muted-custom mt-3">
        At stayIndulgent, we believe accommodation should be an experience, not
        just a place to sleep. Founded in 2023, we travel the globe to secure
        rare, exquisite residences, pairing every destination with a high-touch
        concierge experience designed for the discerning traveler.
      </p>
      <p class="text-muted-custom">
        Our mission began with a clear purpose: to build a seamless platform
        where discerning travelers can discover and reserve extraordinary spaces
        with absolute confidence.
      </p>
      <a href="/contact" class="btn btn-gold-outline mt-3">Get in Touch</a>
    </div>
    <div class="col-lg-6" data-aos="fade-left">
      <div style="position: relative">
        <div
          style="
            position: absolute;
            top: -10px;
            left: -10px;
            right: 10px;
            bottom: 10px;
            z-index: 1;
          "
        ></div>
        <img
          src="https://images.unsplash.com/photo-1749486207569-df55d727d6f0?q=80&w=2097&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
          alt="Luxury Architecture"
          class="img-fluid rounded shadow position-relative"
          style="z-index: 2; display: block"
        />
      </div>
    </div>
  </div>
</div>

<div class="stats-strip my-5">
  <div class="container">
    <div class="row text-center g-4">
      <div class="col-6 col-md-3" data-aos="fade-up">
        <div class="stat-number">500+</div>
        <div class="stat-label">Luxury Properties</div>
      </div>
      <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="150">
        <div class="stat-number">50+</div>
        <div class="stat-label">Countries</div>
      </div>
      <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="300">
        <div class="stat-number">10,000+</div>
        <div class="stat-label">Happy Guests</div>
      </div>
      <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="450">
        <div class="stat-number">24/7</div>
        <div class="stat-label">Concierge Service</div>
      </div>
    </div>
  </div>
</div>

<div class="py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="section-title text-center" data-aos="fade-up">
        What Sets Us Apart
      </h2>
    </div>
    <div class="row g-4">
      <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
        <div class="card card-premium h-100 text-white p-3">
          <div class="card-body text-center">
            <i class="fas fa-gem fa-2x icon-gold"></i>
            <h4 class="mb-3" style="letter-spacing: 0.5px">
              Curated Excellence
            </h4>
            <p class="text-muted-custom mb-0">
              We handpick each property to ensure it meets our stringent
              standards of luxury and uniqueness.
            </p>
          </div>
        </div>
      </div>
      <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
        <div class="card card-premium h-100 text-white p-3">
          <div class="card-body text-center">
            <i class="fas fa-concierge-bell fa-2x icon-gold"></i>
            <h4 class="mb-3" style="letter-spacing: 0.5px">
              Personalized Service
            </h4>
            <p class="text-muted-custom mb-0">
              Our dedicated concierge team is available 24/7 to cater to your
              every need and desire.
            </p>
          </div>
        </div>
      </div>
      <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
        <div class="card card-premium h-100 text-white p-3">
          <div class="card-body text-center">
            <i class="fas fa-globe fa-2x icon-gold"></i>
            <h4 class="mb-3" style="letter-spacing: 0.5px">Global Reach</h4>
            <p class="text-muted-custom mb-0">
              From hidden gems to iconic destinations, we offer extraordinary
              stays around the world.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container py-4 my-4">
  <div class="text-center mb-5">
    <h2 class="section-title text-center" data-aos="fade-up">
      What Our Guests Say
    </h2>
  </div>
  <div class="row g-4">
    <div class="col-md-6" data-aos="fade-right">
      <div class="testimonial-bubble">
        <p class="fst-italic text-light mb-3">
          "stayIndulgent provided an unforgettable experience. The attention to
          detail and personalized service were beyond compare."
        </p>
        <p
          class="mb-0 font-weight-bold"
          style="color: var(--gold-primary); font-size: 0.9rem"
        >
          — Sarah J., Thailand
        </p>
      </div>
    </div>
    <div class="col-md-6" data-aos="fade-left">
      <div class="testimonial-bubble">
        <p class="fst-italic text-light mb-3">
          "From booking to check-out, stayIndulgent made our vacation truly
          luxurious. We can't wait to book our next stay!"
        </p>
        <p
          class="mb-0 font-weight-bold"
          style="color: var(--gold-primary); font-size: 0.9rem"
        >
          — Hanna., Paris
        </p>
      </div>
    </div>
  </div>
</div>

<div class="container py-5 my-4">
  <div class="text-center mb-5">
    <h2 class="section-title text-center" data-aos="fade-up">Our Locations</h2>
  </div>
  <div class="row g-4">
    <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
      <div class="location-box">
        <i class="fas fa-map-marker-alt fa-2x icon-gold"></i>
        <h3 class="text-white">New York</h3>
        <p class="text-muted-custom mb-0 mt-2">
          Experience the vibrant energy of the Big Apple with our luxurious
          Manhattan penthouses.
        </p>
      </div>
    </div>
    <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
      <div class="location-box">
        <i class="fas fa-map-marker-alt fa-2x icon-gold"></i>
        <h3 class="text-white">Paris</h3>
        <p class="text-muted-custom mb-0 mt-2">
          Indulge in the romance of the City of Light with our elegant Parisian
          apartments.
        </p>
      </div>
    </div>
    <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
      <div class="location-box">
        <i class="fas fa-map-marker-alt fa-2x icon-gold"></i>
        <h3 class="text-white">Tokyo</h3>
        <p class="text-muted-custom mb-0 mt-2">
          Discover the perfect blend of tradition and modernity in our luxurious
          Tokyo residences.
        </p>
      </div>
    </div>
  </div>
</div>

<div
  class="premium-hero"
  style="
    height: 50vh;
    background-image: url('https://images.unsplash.com/photo-1445019980597-93fa8acb246c?q=80&w=2074&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');
  "
>
  <div class="premium-hero-content">
    <h2
      class="display-4 text-white mb-4"
      data-aos="fade-up"
      style="font-weight: 700"
    >
      Join Us on a Journey of Luxury
    </h2>
    <a href="/listings" class="btn btn-gold btn-lg" data-aos="zoom-in">
      Explore Our Properties
    </a>
  </div>
</div>

<script>
  // Re-verify AOS is initialized smoothly for layout animations
  if (typeof AOS !== "undefined") {
    AOS.init({
      duration: 1000,
      once: true,
    });
  }
</script>
